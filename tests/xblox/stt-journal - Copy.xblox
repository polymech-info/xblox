{
  "context": {
    "journal": "${ENV:USERPROFILE}/Documents/journal.txt",
    "recordSession": "",
    "recording": false,
    "started": false,
    "transcript": "",
    "wavPath": ""
  },
  "loop": {
    "enabled": true,
    "intervalMs": 50,
    "reset": false
  },
  "roots": [
    {
      "condition": "started == 0",
      "consequent": [
        {
          "kind": "stdout",
          "message": "── stt-journal ─────────────────────────────────────────────"
        },
        {
          "kind": "stdout",
          "message": "Press Shift+F12 to start recording. Press Shift+F12 again to stop and append."
        },
        {
          "kind": "stdout",
          "message": "Ctrl+C to exit."
        },
        {
          "kind": "stdout",
          "message": " "
        },
        {
          "kind": "setVariable",
          "name": "started",
          "value": true
        }
      ],
      "kind": "if"
    },
    {
      "anyKey": false,
      "keys": "Shift+F12",
      "kind": "keyEvent",
      "storeAs": "f9",
      "toggle": true
    },
    {
      "condition": "f9.pressed",
      "consequent": [
        {
          "condition": "recording",
          "consequent": [
            {
              "kind": "stdout",
              "message": "stop recording"
            },
            {
              "kind": "audioRecordStop",
              "session": "${recordSession}",
              "storeAs": "wavPath"
            },
            {
              "kind": "setVariable",
              "name": "recording",
              "value": false
            },
            {
              "input": "${wavPath}",
              "kind": "audioTranscribe",
              "model": "base.en",
              "provider": "whisper",
              "providerOptions": {
                "backend": "cpu"
              },
              "storeAs": "transcript"
            },
            {
              "kind": "stdout",
              "message": "recording stopped; transcript: ${transcript}"
            },
            {
              "append": true,
              "content": "[${YYYY}-${MM}-${DD} ${HH}:${mm}:${SS}] ${transcript}\n",
              "kind": "fsWrite",
              "path": "${journal}",
              "storeAs": "journalPath"
            },
            {
              "kind": "stdout",
              "message": "appended: [${YYYY}-${MM}-${DD} ${HH}:${mm}:${SS}] ${transcript} - ${journal}"
            }
          ],
          "kind": "if"
        },
        {
          "items": [
            {
              "kind": "stdout",
              "message": "start recording"
            },
            {
              "kind": "audioRecordStart",
              "storeAs": "recordSession"
            },
            {
              "kind": "setVariable",
              "name": "recording",
              "value": true
            }
          ],
          "kind": "else"
        }
      ],
      "kind": "if"
    }
  ],
  "version": 1
}
