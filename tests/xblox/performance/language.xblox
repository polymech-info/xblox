      "kind": "switch",
      "variable": "mode"
    },
    {
      "blockId": "stdout-4x8rm6",
      "kind": "stdout",
      "message": " "
    },
    {
      "blockId": "stdout-1krcil",
      "kind": "stdout",
      "message": "[4] while + break — break exits the nearest loop only"
    },
    {
      "blockId": "setVariable-sryv7v",
      "kind": "setVariable",
      "name": "n",
      "value": 0
    },
    {
      "blockId": "while-1il1ks",
      "condition": "n < 10",
