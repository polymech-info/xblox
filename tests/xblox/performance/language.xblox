  "roots": [
    {
      "blockId": "stdout-u1voz6",
      "kind": "stdout",
      "message": "── xblox language showcase ─────────────────────────────────"
    },
    {
      "blockId": "stdout-z8zu0s",
      "kind": "stdout",
      "message": "[1] if / elseIf / else — sibling chain, first match wins"
    },
    {
      "blockId": "if-1cuw2x",
      "condition": "score >= 9",
      "consequent": [
        {
          "blockId": "stdout-1tzkli",
          "kind": "stdout",
          "message": "  score=${score} → grade A (UNEXPECTED)"
        }
      ],
      "kind": "if"
    },
    {
      "blockId": "elseIf-2amzma",
      "condition": "score >= 6",
      "items": [
        {
          "blockId": "stdout-1ruhf2",
          "kind": "stdout",
          "message": "  score=${score} → grade B (elseIf matched)"
        }
      ],
      "kind": "elseIf"
    },
    {
      "blockId": "elseIf-xdpwdl",
      "condition": "score >= 3",
      "items": [
        {
          "blockId": "stdout-149o2p",
          "kind": "stdout",
          "message": "  score=${score} → grade C (skipped — chain already matched)"
        }
      ],
      "kind": "elseIf"
    },
    {
      "blockId": "else-u76ndc",
      "items": [
        {
          "blockId": "stdout-1ac2mq",
          "kind": "stdout",
          "message": "  score=${score} → grade F (skipped — chain already matched)"
        }
      ],
      "kind": "else"
    },
    {
      "blockId": "stdout-1936o7",
      "kind": "stdout",
      "message": " "
    },
    {
      "blockId": "stdout-3ikhj0",
      "kind": "stdout",
      "message": "[2] nested chain — a fresh chain inside a consequent"
    },
    {
      "blockId": "if-1smz03",
      "condition": "score > 0",
      "consequent": [
        {
          "blockId": "if-5wm21t",
          "condition": "user.name == \"alex\"",
          "consequent": [
            {
              "blockId": "stdout-u5vw99",
              "kind": "stdout",
              "message": "  hello alex (UNEXPECTED)"
            }
          ],
          "kind": "if"
        },
        {
          "blockId": "else-1c5ris",
          "items": [
            {
              "blockId": "stdout-1wz5t4",
              "kind": "stdout",
              "message": "  hello ${user.name} (inner else ran)"
            }
          ],
          "kind": "else"
        }
      ],
      "kind": "if"
    },
    {
      "blockId": "stdout-1emu0d",
      "kind": "stdout",
      "message": " "
    },
    {
      "blockId": "stdout-13bczh",
      "kind": "stdout",
      "message": "[3] switch / case / default — first match, no fallthrough"
    },
    {
      "blockId": "switch-11ag24",
      "items": [
        {
          "blockId": "case-e8dip9",
          "comparator": "===",
          "consequent": [
            {
              "blockId": "stdout-1e9p48",
              "kind": "stdout",
              "message": "  mode=alpha (UNEXPECTED)"
            }
          ],
          "expression": "\"alpha\"",
          "kind": "case"
        },
        {
          "blockId": "case-1ac706",
          "comparator": "===",
          "consequent": [
            {
              "blockId": "stdout-1h13eb",
              "kind": "stdout",
              "message": "  mode=${mode} → beta case ran"
            }
          ],
          "expression": "\"beta\"",
          "kind": "case"
        },
        {
          "blockId": "switchDefault-z791um",
          "consequent": [
            {
              "blockId": "stdout-1w0ef3",
              "kind": "stdout",
              "message": "  mode=${mode} → default (UNEXPECTED)"
            }
          ],
          "kind": "switchDefault"
