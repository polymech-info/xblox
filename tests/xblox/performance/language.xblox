          "kind": "setVariable",
          "name": "n"
        },
        {
          "blockId": "stdout-trtnc6",
          "kind": "stdout",
          "message": "  while tick n=${n}"
        },
        {
          "blockId": "if-1tze7j",
          "condition": "n == 3",
          "consequent": [
            {
              "blockId": "stdout-08m1v1",
